# Where the backend API lives (the browser calls it directly).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Production: forward /v1 to the backend (so cookies stay on one site) and open the
# WebSocket straight to it, since the web host doesn't proxy sockets.
# BACKEND_URL=https://ticker-backend.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://ticker-backend.up.railway.app/ws

# Signs the visitor's IP for the backend's rate limits. Same value on both services,
# at least 24 characters.
# EDGE_SECRET=
